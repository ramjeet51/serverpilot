# =============================================================================
# ServerPilot frontend (Next.js)
# -----------------------------------------------------------------------------
# Only NEXT_PUBLIC_* values reach the browser and they are baked in at build
# time (rebuild after changing them: ./scripts/deploy.sh). NEVER put secrets here.
# =============================================================================

# Display name in the UI.
NEXT_PUBLIC_APP_NAME=ServerPilot
# Browser-reachable FastAPI base URL (no trailing slash). Its host must match how you open the UI.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-reachable WebSocket base URL for real-time events.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
