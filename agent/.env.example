# =============================================================================
# ServerPilot Linux Agent (installed on each managed Ubuntu server - Phase 2)
# -----------------------------------------------------------------------------
# Installed to /etc/serverpilot-agent/agent.env (mode 0600, owner root) by the
# installer. NEVER commit the real agent/.env file.
# =============================================================================

# Management server agent gateway (outbound connection from the Ubuntu server).
AGENT_SERVER_URL=wss://management.lan:8001
# mtls (production) | test_token (local LAN testing only)
AGENT_AUTH_MODE=test_token
# One-time registration token shown in the UI when you add a server.
AGENT_REGISTRATION_TOKEN=
# Persistent identity and certificate storage on the managed server.
AGENT_STATE_DIRECTORY=/var/lib/serverpilot-agent
AGENT_CERTIFICATE_PATH=/etc/serverpilot-agent/certs
# CA bundle used to verify the management server certificate.
AGENT_CA_BUNDLE=/etc/serverpilot-agent/certs/ca.pem
# Heartbeat interval in seconds (server may override).
AGENT_HEARTBEAT_INTERVAL=15
# Reconnect backoff bounds in seconds.
AGENT_RECONNECT_MIN_SECONDS=2
AGENT_RECONNECT_MAX_SECONDS=60

# File operations are restricted to these absolute roots.
ALLOWED_FILE_ROOTS=/home,/var/www,/etc/nginx,/opt
FILE_OPERATION_TIMEOUT=30

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIRECTORY=/var/log/serverpilot-agent
