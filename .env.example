# =============================================================================
# ServerPilot - shared platform configuration (project root)
# -----------------------------------------------------------------------------
# Copy to .env (scripts/setup.sh does this and generates secrets for you).
# Read by: backend, Celery worker, agent gateway, PM2 ecosystem and shell scripts.
# Service-specific values live in backend/.env, frontend/.env and agent/.env.
# NEVER commit the real .env file.
# =============================================================================

# ---- Application -------------------------------------------------------------
# Display name used in API titles, JWT issuer and logs.
APP_NAME=ServerPilot
# development | staging | production | test   (production enforces strong secrets)
APP_ENV=development
# Verbose error pages. Must be false in production.
APP_DEBUG=false
# IANA timezone used by the scheduler (UTC recommended).
APP_TIMEZONE=UTC

# ---- Frontend (Next.js) ------------------------------------------------------
# Interface Next.js binds to. 127.0.0.1 = this Mac only; 0.0.0.0 = LAN access.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

# ---- Backend (FastAPI / Uvicorn) --------------------------------------------
# Keep on 127.0.0.1 or a LAN address. Never expose directly to the internet.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Agent Communication Gateway --------------------------------------------
# Address the gateway process binds to. Keep 127.0.0.1 unless agents can route to this Mac.
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=8001
# Optional SSH reverse tunnel when the Ubuntu host cannot reach this Mac.
# The agent then uses ws://127.0.0.1:AGENT_TUNNEL_REMOTE_PORT/v1/connect on that host.
# Example shape: user@192.0.2.10
AGENT_TUNNEL_SSH=
AGENT_TUNNEL_REMOTE_PORT=8001

# ---- PostgreSQL (Homebrew service) ------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=serverpilot
POSTGRES_USER=serverpilot
# Generated by setup.sh. Used by db-setup.sh to create the role.
POSTGRES_PASSWORD=change-me
# Existing superuser role db-setup.sh connects as to create the role/databases.
# Empty = your macOS username (the Homebrew default).
PG_SUPERUSER=

# ---- Redis (Homebrew service) -----------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave empty if Redis has no requirepass (default Homebrew install, localhost only).
REDIS_PASSWORD=
REDIS_DB=0

# ---- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (structured, recommended) | console (human readable)
LOG_FORMAT=json
# PM2 and application logs. Relative paths are resolved from the project root.
LOG_DIRECTORY=logs
