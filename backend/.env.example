# =============================================================================
# ServerPilot backend / worker / agent-gateway configuration
# -----------------------------------------------------------------------------
# Loaded after the root .env (values here win). Process environment wins over both.
# NEVER commit the real backend/.env file.
# =============================================================================

# ---- Application secrets ----------------------------------------------------
# Random 64+ char values. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change-me
# Expose Swagger UI at /api/docs. Disable in production if not needed.
API_DOCS_ENABLED=true

# ---- Backend process --------------------------------------------------------
# Uvicorn worker processes inside the single PM2 "serverpilot-backend" app.
# Stateless API + Redis-backed sessions/rate limits/pub-sub make multiple workers safe.
BACKEND_WORKERS=2
# Comma-separated browser origins allowed to call the API (must match the URL you open the UI on).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ---------------------------------------------------------------
# Optional full override. If empty it is built from POSTGRES_* in the root .env.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis / Celery ---------------------------------------------------------
# Optional overrides; default to redis://[:REDIS_PASSWORD@]REDIS_HOST:REDIS_PORT/REDIS_DB
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Celery worker processes.
CELERY_CONCURRENCY=2

# ---- Agent communication ----------------------------------------------------
# Seconds between agent heartbeats.
AGENT_HEARTBEAT_INTERVAL=15
# Seconds without a heartbeat before an agent is marked offline.
AGENT_OFFLINE_TIMEOUT=60
# mtls (per-agent client certificates, production) | test_token (LAN-only local testing)
AGENT_AUTH_MODE=test_token
# Directory for the agent CA and issued certificates (relative to project root or absolute).
AGENT_CERTIFICATE_PATH=certs/agents
# WebSocket URL handed to a new agent. Leave empty to build it from AGENT_GATEWAY_HOST and PORT.
# For an SSH tunnel, set ws://127.0.0.1:8001/v1/connect
AGENT_ADVERTISED_URL=
# Hours before an unused registration token expires.
AGENT_REGISTRATION_TTL_HOURS=24

# ---- Security ---------------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# TOTP MFA enforcement arrives in Phase 7; must stay false until then.
REQUIRE_MFA=false
# Set true when serving over HTTPS (Nginx/TLS) so cookies get the Secure flag.
COOKIE_SECURE=false
# Login attempts per IP+email per window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Failed passwords before temporary lockout, and lockout length.
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=15
# General API requests per IP per minute.
API_RATE_LIMIT_PER_MINUTE=300

# ---- Initial administrator (used once by `python -m app.cli seed`) ----------
# setup.sh generates a strong password. Change it after first login, then you may clear it here.
INITIAL_ADMIN_EMAIL=admin@serverpilot.local
INITIAL_ADMIN_PASSWORD=change-me

# ---- Jobs -------------------------------------------------------------------
JOB_DEFAULT_TIMEOUT_SECONDS=600
JOB_MAX_TIMEOUT_SECONDS=3600

# ---- File management (enforced by agent file operations from Phase 5) -------
MAX_UPLOAD_SIZE_MB=100
FILE_OPERATION_TIMEOUT=30
# Comma-separated absolute roots that file operations may touch on managed servers.
ALLOWED_FILE_ROOTS=/home,/var/www,/etc/nginx,/opt
